---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Sound Therapy Session Booking",
  "provider": {
    "@type": "HealthAndBeautyBusiness",
    "name": "Calm Through Sounds",
    "url": "https://calmthroughsound.com"
  },
  "areaServed": { "@type": "City", "name": "Singapore" }
};
---

<BaseLayout
  title="Book a Session | Calm Through Sounds"
  description="Book a sound therapy session with Cara in Bukit Panjang, Singapore. Choose a 30-minute taster or 60-minute signature session and reserve your slot instantly."
  schema={schema}
>
  <style>
    * { box-sizing: border-box; }

    /* NAV */
    .book-nav {
      position: sticky; top: 0; z-index: 100;
      background: var(--cream); border-bottom: 1px solid var(--tan);
      padding: 0 clamp(20px, 5vw, 60px);
      display: flex; align-items: center; justify-content: space-between; height: 68px;
    }
    .book-nav .logo { font-family: 'Cormorant Garamond', serif; font-size: 1.35rem; font-weight: 600; letter-spacing: .08em; color: var(--ink); text-decoration: none; }
    .book-nav .back { font-size: .85rem; color: var(--taupe-d); text-decoration: none; display: flex; align-items: center; gap: 6px; }
    .book-nav .back:hover { color: var(--ink); }

    /* HERO */
    .book-hero {
      background: var(--sand);
      padding: clamp(52px, 8vw, 96px) clamp(20px, 5vw, 60px) clamp(40px, 6vw, 72px);
      text-align: center;
    }
    .book-hero .eyebrow { display: block; margin-bottom: 14px; }
    .book-hero h1 { font-family: 'Cormorant Garamond', serif; font-size: clamp(2.2rem, 5vw, 3.4rem); font-weight: 500; color: var(--ink); margin: 0 0 18px; line-height: 1.15; }
    .book-hero p { max-width: 520px; margin: 0 auto; color: var(--bark-soft); font-size: 1.05rem; line-height: 1.7; }

    /* SESSION CARDS */
    .session-selector {
      padding: clamp(40px, 6vw, 72px) clamp(20px, 5vw, 60px);
      max-width: 960px; margin: 0 auto;
    }
    .session-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 0;
    }
    @media (max-width: 640px) { .session-grid { grid-template-columns: 1fr; } }

    .scard {
      border-radius: 20px; padding: 36px 32px 32px;
      display: flex; flex-direction: column;
      border: 1px solid var(--tan);
      transition: box-shadow .3s ease, transform .3s ease;
    }
    .scard:hover { transform: translateY(-4px); box-shadow: 0 20px 48px -20px rgba(63,55,46,.28); }
    .scard.taster { background: var(--cream); }
    .scard.signature { background: var(--taupe-d); }

    .scard .label { font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; font-weight: 700; margin-bottom: 10px; }
    .scard.taster .label { color: var(--taupe-d); }
    .scard.signature .label { color: #cdbfae; }

    .scard h2 { font-family: 'Cormorant Garamond', serif; font-size: clamp(1.6rem, 3vw, 2rem); font-weight: 500; margin: 0 0 10px; line-height: 1.15; }
    .scard.taster h2 { color: var(--ink); }
    .scard.signature h2 { color: #fff; }

    .scard .desc { font-size: .96rem; line-height: 1.65; margin-bottom: 24px; flex: 1; }
    .scard.taster .desc { color: var(--bark-soft); }
    .scard.signature .desc { color: #e7e2d6; }

    .scard .price-tag { margin-bottom: 28px; }
    .scard .amt { font-family: 'Cormorant Garamond', serif; font-size: 2.6rem; line-height: 1; }
    .scard.taster .amt { color: var(--ink); }
    .scard.signature .amt { color: #fff; }
    .scard .per { font-size: .82rem; margin-top: 4px; }
    .scard.taster .per { color: var(--bark-soft); }
    .scard.signature .per { color: #cdbfae; }
    .scard .orig { text-decoration: line-through; margin-left: 8px; }
    .scard.taster .orig { color: var(--bark-soft); }
    .scard.signature .orig { color: rgba(255,255,255,.45); }

    .scard .book-btn {
      display: block; text-align: center; text-decoration: none;
      padding: 14px 24px; border-radius: 34px;
      font-family: 'Nunito Sans', sans-serif; font-size: .95rem; font-weight: 700;
      transition: background .2s, border-color .2s;
    }
    .scard.taster .book-btn { background: var(--ink); color: var(--cream); }
    .scard.taster .book-btn:hover { background: var(--bark); }
    .scard.signature .book-btn { background: rgba(255,255,255,.15); color: #fff; border: 1.5px solid rgba(255,255,255,.5); }
    .scard.signature .book-btn:hover { background: rgba(255,255,255,.25); border-color: #fff; }

    .scard .features { list-style: none; margin: 0 0 28px; padding: 0; }
    .scard .features li { font-size: .88rem; padding: 5px 0; display: flex; align-items: center; gap: 8px; }
    .scard.taster .features li { color: var(--bark-soft); }
    .scard.signature .features li { color: #e7e2d6; }
    .scard .features li::before { content: "○"; font-size: .7rem; flex-shrink: 0; }
    .scard.taster .features li::before { color: var(--taupe); }
    .scard.signature .features li::before { color: #cdbfae; }

    /* DIVIDER */
    .or-divider {
      text-align: center; padding: 0 clamp(20px, 5vw, 60px) clamp(32px, 4vw, 48px);
      color: var(--bark-soft); font-size: .85rem;
    }

    /* NOTICE */
    .booking-notice {
      max-width: 820px; margin: 0 auto clamp(28px, 4vw, 48px);
      padding: 0 clamp(20px, 5vw, 60px);
    }
    .booking-notice .inner {
      background: var(--sand); border: 1px solid var(--tan); border-radius: 12px;
      padding: 20px 24px; font-size: .9rem; color: var(--bark-soft); line-height: 1.6;
    }
    .booking-notice strong { color: var(--ink); }

    /* INTAKE */
    .intake-note {
      text-align: center;
      padding: clamp(40px, 5vw, 60px) clamp(20px, 5vw, 60px) clamp(52px, 7vw, 80px);
      background: var(--cream);
    }
    .intake-note p { max-width: 520px; margin: 0 auto 24px; color: var(--bark-soft); line-height: 1.7; }
    .intake-btn {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--ink); color: var(--cream);
      padding: 14px 28px; border-radius: 32px;
      font-family: 'Nunito Sans', sans-serif; font-weight: 700; font-size: .95rem;
      text-decoration: none; transition: background .2s;
    }
    .intake-btn:hover { background: var(--bark); }

    footer.book-footer {
      background: var(--bark); color: var(--tan);
      text-align: center; padding: 24px; font-size: .82rem;
    }
    footer.book-footer a { color: var(--tan); }
  </style>

  <!-- Nav -->
  <nav class="book-nav">
    <a class="logo" href="/">Calm Through Sounds</a>
    <a class="back" href="/">&#8592; Back to home</a>
  </nav>

  <!-- Hero -->
  <header class="book-hero">
    <span class="eyebrow">Book a session</span>
    <h1>Find your hour of calm</h1>
    <p>Choose the session that feels right for you. You'll receive a confirmation email with everything you need before you arrive.</p>
  </header>

  <!-- Session selector -->
  <div class="session-selector">
    <div class="session-grid">

      <!-- Taster — Google Appointments -->
      <div class="scard taster">
        <span class="label">30 minutes · 1 person</span>
        <h2>Taster Session</h2>
        <p class="desc">A gentle introduction to sound therapy. Lie down, close your eyes and let the sound do the rest. Ideal if you've never tried a sound bath before.</p>
        <ul class="features">
          <li>Crystal bowl &amp; chimes</li>
          <li>Personalised to how you feel that day</li>
          <li>No experience needed</li>
        </ul>
        <div class="price-tag">
          <div class="amt">$45*<span class="orig">$50</span></div>
          <div class="per">per person</div>
        </div>
        <a class="book-btn" href="https://calendar.app.google/KUsHxUSGr7uqk7S57" target="_blank" rel="noopener">
          Book Taster Session &rarr;
        </a>
      </div>

      <!-- Signature — Calendly -->
      <div class="scard signature">
        <span class="label">60 minutes · 1 person</span>
        <h2>Signature Session</h2>
        <p class="desc">The full sound journey: gong, crystal bowl, ocean drum and chimes. Space to fully arrive, settle and rest. Also available as a small group session.</p>
        <ul class="features">
          <li>Full instrument set</li>
          <li>Full instrument set: gong, bowl, ocean drum, chimes</li>
          <li>Trauma-aware facilitation</li>
        </ul>
        <div class="price-tag">
          <div class="amt">$100*<span class="orig">$120</span></div>
          <div class="per">per person</div>
        </div>
        <a class="book-btn" href="https://calendly.com/calmthroughsounds/book-a-session" target="_blank" rel="noopener">
          Reserve Signature Session &rarr;
        </a>
      </div>

    </div>
  </div>

  <!-- Studio address notice -->
  <div class="booking-notice">
    <div class="inner">
      <strong>Studio address:</strong> Shared after booking confirmation. The home studio is in Bukit Panjang.
      <p style="margin: 8px 0 0; font-size: .8rem;">* Prices marked with an asterisk are valid 1–31 July 2026 only.</p>
    </div>
  </div>

  <!-- Intake form -->
  <div class="intake-note">
    <p>Already booked? Please complete the short intake form before your first session so I can tailor the experience to you.</p>
    <a class="intake-btn" href="https://docs.google.com/forms/d/e/1FAIpQLScP3C1CagJP2gTr3hiDV0XS3pl805LQptAeZ7h5kU-t80nDLQ/viewform" target="_blank" rel="noopener">Complete intake form &rarr;</a>
  </div>

  <footer class="book-footer">
    <p>&copy; {new Date().getFullYear()} Calm Through Sounds &middot; <a href="/">Home</a></p>
  </footer>

</BaseLayout>
