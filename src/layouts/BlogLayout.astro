---
import BaseLayout from './BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';

export interface Props {
  title: string;
  description: string;
  tag: string;
  pubDate: Date;
  readTime: string;
  heroImage?: string;
  ogTitle?: string;
  ogDescription?: string;
  keywords?: string;
  slug: string;
  keyTakeaways?: string[];
}

const { title, description, tag, pubDate, readTime, heroImage, ogTitle, ogDescription, keywords, slug, keyTakeaways } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString().split('T')[0],
  dateModified: pubDate.toISOString().split('T')[0],
  inLanguage: 'en-SG',
  author: { '@type': 'Person', name: 'Cara', jobTitle: 'Certified Sound Therapist' },
  publisher: { '@type': 'Organization', name: 'Calm Through Sounds', url: 'https://calmthroughsound.com' },
  url: `https://calmthroughsound.com/blog/${slug}/`,
  keywords: keywords ?? '',
};

const navLinks = [
  { href: '/#science', label: 'The Science' },
  { href: '/#sessions', label: 'Sessions' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/#testimonials', label: 'Testimonials' },
  { href: '/#giving', label: 'Giving' },
  { href: '/blog/', label: 'Journal', active: true },
  { href: '/#about', label: 'About' },
];
---

<BaseLayout title={`${title} | Calm Through Sounds`} description={description} ogType="article" ogTitle={ogTitle ?? title} ogDescription={ogDescription ?? description} schema={schema}>
  <style>
    .nav { position: sticky; top: 0; z-index: 50; background: rgba(250,246,239,.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--tan); }
    .hero-blog { background: radial-gradient(900px 400px at 85% -10%, rgba(154,143,128,.18), transparent 60%), var(--sand); padding: 54px 0 44px; }
    article.wrap { max-width: 760px; }
    .tag { text-transform: uppercase; letter-spacing: .16em; font-size: .74rem; font-weight: 700; color: var(--taupe-d); }
    h1 { font-size: clamp(2.1rem, 5vw, 3rem); margin: 12px 0 14px; }
    .sub { font-size: 1.18rem; color: var(--bark-soft); }
    .byline { margin-top: 20px; font-size: .9rem; color: var(--bark-soft); display: flex; align-items: center; gap: 10px; }
    .byline .av { width: 34px; height: 34px; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #f3e3cd, #cda978); flex-shrink: 0; }
    .article-hero-img { height: clamp(220px, 40vh, 400px); background-size: cover; background-position: center; background-attachment: fixed; }
    @media (max-width: 760px) { .article-hero-img { background-attachment: scroll; height: clamp(180px, 30vh, 300px); } }
    .body { padding: 42px 0 10px; max-width: 760px; margin: 0 auto; padding-left: 22px; padding-right: 22px; }
    .body h2 { font-size: 1.7rem; margin: 34px 0 12px; }
    .body p { margin-bottom: 18px; font-size: 1.06rem; }
    .body strong { color: var(--bark); }
    .body sup { font-size: .7em; line-height: 0; }
    .body sup a { color: var(--taupe-d); text-decoration: none; font-weight: 700; padding: 0 1px; }
    .body sup a:hover { text-decoration: underline; }
    .callout { background: var(--sand); border-left: 4px solid var(--taupe); border-radius: 10px; padding: 18px 22px; margin: 26px 0; font-size: 1rem; color: var(--bark-soft); }
    .callout.takeaways { padding: 20px 24px; }
    .callout.takeaways .tk-label { font-size: .74rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; color: var(--taupe-d); margin-bottom: 10px; }
    .callout.takeaways ul { margin: 0 0 0 18px; }
    .callout.takeaways li { margin-bottom: 8px; }
    .callout.takeaways li:last-child { margin-bottom: 0; }
    .refs { background: var(--sand); border: 1px solid var(--tan); border-radius: 16px; padding: 26px 28px; margin: 40px 0; }
    .refs h2 { font-size: 1.3rem; margin-bottom: 12px; }
    .refs ol { margin-left: 18px; font-size: .92rem; color: var(--bark-soft); }
    .refs li { margin-bottom: 10px; scroll-margin-top: 90px; }
    .refs li:target { background: #fff; outline: 2px solid var(--taupe); outline-offset: 4px; border-radius: 4px; }
    .author-card { display: flex; gap: 16px; align-items: center; background: var(--cream); border: 1px solid var(--tan); border-radius: 16px; padding: 20px 24px; margin: 34px 0; }
    .author-card .av { width: 54px; height: 54px; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #f3e3cd, #cda978); flex-shrink: 0; }
    .author-card p { font-size: .92rem; color: var(--bark-soft); margin: 0; }
    .disc { font-size: .82rem; color: var(--bark-soft); background: #f3ece0; border-radius: 10px; padding: 16px 20px; margin: 26px 0; }
    .cta-card { background: var(--taupe-d); color: #fff; text-align: center; border-radius: 20px; padding: 36px 26px; margin: 42px 0; }
    .cta-card h2 { color: #fff; font-size: 1.7rem; }
    .cta-card p { max-width: 470px; margin: 8px auto 18px; color: #e7e2d6; }
    .cta-card a { display: inline-block; background: var(--taupe); color: #fff; padding: 13px 26px; border-radius: 30px; font-weight: 700; text-decoration: none; }
    .cta-card a:hover { background: #7a6e60; }
    .more { border-top: 1px solid var(--tan); margin-top: 36px; padding: 30px 0 10px; }
    .more h2 { font-size: 1.4rem; margin-bottom: 14px; }
    .more a { display: block; padding: 12px 0; border-bottom: 1px solid var(--tan); text-decoration: none; color: var(--bark); font-weight: 600; }
    .more a:hover { color: var(--taupe-d); }
    .backlink { display: inline-block; margin-bottom: 14px; font-weight: 700; color: var(--taupe-d); text-decoration: none; font-size: .92rem; }
    .backlink:hover { text-decoration: underline; }
    .vs { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 20px 0; }
    @media (max-width: 600px) { .vs { grid-template-columns: 1fr; } }
    .vs .col { background: var(--sand); border-radius: 12px; padding: 20px 22px; }
    .vs .col h3 { font-size: 1.1rem; margin-bottom: 10px; }
    .vs .col ul { margin-left: 18px; font-size: .96rem; color: var(--bark-soft); }
    .vs .col ul li { margin-bottom: 6px; }
    .vs .col.yes { border-left: 4px solid #7aaa7a; }
    .vs .col.no { border-left: 4px solid #c07070; }
  </style>

  <div class="promo">&#10022;&nbsp;&nbsp;Founding-client rates: first two months</div>

  <header class="nav">
    <div class="nav-inner">
      <a class="brand" href="/"><span class="dot"></span>Calm Through Sounds</a>
      <button class="hamburger" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="navMenu">
        <span></span><span></span><span></span>
      </button>
      <div class="nav-menu" id="navMenu">
        <nav>
          <ul>
            {navLinks.map(l => (
              <li><a href={l.href} class={l.active ? 'active' : ''}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="nav-cta" href="/book/">Book a session</a>
      </div>
    </div>
  </header>

  <div class="hero-blog">
    <article class="wrap">
      <a class="backlink" href="/blog/">← All articles</a>
      <span class="tag">{tag}</span>
      <h1>{title}</h1>
      <slot name="sub" />
      <div class="byline">
        <span class="av"></span>
        <span>By Cara, Certified Sound Therapist · {pubDate.toLocaleDateString('en-SG', { day: 'numeric', month: 'long', year: 'numeric' })} · {readTime}</span>
      </div>
    </article>
  </div>

  {heroImage && (
    <div class="article-hero-img" style={`background-image:url('${heroImage}')`} aria-hidden="true"></div>
  )}

  <div class="body">
    {keyTakeaways && keyTakeaways.length > 0 && (
      <div class="callout takeaways">
        <p class="tk-label">Key takeaways</p>
        <ul>
          {keyTakeaways.map((point) => <li>{point}</li>)}
        </ul>
      </div>
    )}
    <slot />
  </div>

  <footer>
    <div class="wrap">
      <div>
        <div class="brand" style="color:#fff;margin-bottom:8px"><span class="dot"></span>Calm Through Sounds</div>
        <div>Research-Informed Sound Therapy · Bukit Panjang, Singapore</div>
      </div>
      <div>
        <a href="/#science">The Science</a> &nbsp;·&nbsp;
        <a href="/#sessions">Sessions</a> &nbsp;·&nbsp;
        <a href="/#pricing">Pricing</a> &nbsp;·&nbsp;
        <a href="/blog/">Journal</a> &nbsp;·&nbsp;
        <a href="/#contact">Contact</a>
      </div>
    </div>
  </footer>
  <NewsletterSignup />
  <div class="disclaimer">
    <div class="wrap">
      Calm Through Sounds provides sound therapy as a complementary relaxation and wellness practice. It is not medical, psychological, or psychiatric treatment, and is not a substitute for professional healthcare. If you have a medical or mental-health condition, please consult your doctor. Results vary from person to person.
    </div>
  </div>
</BaseLayout>
