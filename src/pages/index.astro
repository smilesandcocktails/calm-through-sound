---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import NewsletterSignup from '../components/NewsletterSignup.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  name: 'Calm Through Sounds',
  description: 'Research-informed sound therapy sessions in Bukit Panjang, Singapore for people managing stress, treatment, and recovery.',
  url: 'https://calmthroughsound.com',
  areaServed: 'Bukit Panjang, Singapore',
  address: { '@type': 'PostalAddress', addressLocality: 'Bukit Panjang', addressCountry: 'SG' },
  founder: { '@type': 'Person', name: 'Cara', jobTitle: 'Certified Sound Therapist' },
  knowsAbout: ['Sound therapy', 'Sound baths', 'Stress reduction', 'Relaxation', 'Wellbeing'],
  priceRange: '$$',
  slogan: 'Quiet the noise. Find your calm.',
};

const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  itemReviewed: { '@type': 'HealthAndBeautyBusiness', name: 'Calm Through Sounds', areaServed: 'Bukit Panjang, Singapore' },
  reviewBody: "I loved the gong bath. I felt so relaxed after the sound session and I can't wait to book my next session.",
  author: { '@type': 'Person', name: 'Mel' },
  reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
};
---

<BaseLayout
  title="Calm Through Sounds | Research-Informed Sound Therapy in Bukit Panjang"
  description="Calm Through Sounds offers research-informed sound therapy sessions in Bukit Panjang, Singapore for people managing stress, treatment, and recovery. Crystal singing bowls, gong, ocean drum and chimes."
  ogTitle="Calm Through Sounds | Research-Informed Sound Therapy in Bukit Panjang"
  ogDescription="Research-informed sound therapy for stress, treatment and recovery. A warm home studio in Bukit Panjang, Singapore."
  schema={[schema, reviewSchema]}
>

<style>
  /* HERO */
  .hero { position: relative; height: calc(100vh - 150px); min-height: 540px; overflow: hidden; background: url('/img-hero.jpg') center 32%/cover no-repeat; }
  .hero::after { content: ""; position: absolute; inset: 0; z-index: 2; pointer-events: none; background: linear-gradient(180deg, rgba(250,246,239,.34), rgba(250,246,239,0) 24%, rgba(250,246,239,0) 56%, rgba(250,246,239,.62)); }
  .waves { position: absolute; left: 50%; top: 54%; transform: translate(-50%,-50%); width: 1600px; max-width: none; height: 230px; z-index: 1; opacity: .7; }
  .waves path { fill: none; stroke: var(--taupe); stroke-width: 1.5; }
  .wordmark { position: absolute; left: 50%; top: 47%; transform: translate(-50%,-50%); font-family: 'Cormorant Garamond', serif; font-weight: 500; color: var(--ink); font-size: clamp(4.5rem, 21vw, 19rem); line-height: .82; letter-spacing: .02em; white-space: nowrap; z-index: 3; }
  .wordmark .thin { font-weight: 400; }
  .hero-cap { position: absolute; right: 6%; top: 24%; text-align: right; z-index: 4; }
  .hero-cap .k { display: block; font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; color: var(--bark); line-height: 1.35; }
  .hero-cap .v { display: block; font-size: .72rem; letter-spacing: .2em; text-transform: uppercase; color: var(--taupe-d); margin-top: 10px; font-weight: 700; }
  .hero-tag { position: absolute; left: 0; right: 0; bottom: 7%; display: flex; justify-content: space-between; align-items: flex-end; padding: 0 28px; z-index: 4; }
  .hero-tag em { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: clamp(1.3rem, 2.4vw, 2.1rem); color: var(--bark); max-width: 9em; line-height: 1.2; }
  .hero-tag a { color: var(--ink); text-decoration: none; font-size: .76rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; border-bottom: 1.5px solid var(--ink); padding-bottom: 4px; }
  @media (max-width: 820px) {
    .hero { height: auto; min-height: 82vh; padding: 9vh 0 5vh; background-image: url('/img-hero-mobile.jpg'); }
    .waves { top: 58%; }
    .wordmark { position: relative; left: auto; top: auto; transform: none; text-align: center; font-size: 24vw; display: block; margin: 5vh 0; padding: 0 12vw; }
    .hero-cap { position: relative; right: auto; top: auto; text-align: center; margin: 0 0 2vh; }
    .hero-cap .k { font-size: 1.25rem; }
    .hero-tag { position: relative; flex-direction: column; gap: 16px; align-items: center; text-align: center; padding: 3vh 24px 4vh; }
    .hero-tag em { max-width: none; }
  }

  /* STATEMENT */
  .statement { text-align: center; }
  .statement p { font-family: 'Cormorant Garamond', serif; font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.25; color: var(--bark); max-width: 14em; margin: 0 auto; }
  .statement .sm { font-family: 'Nunito Sans', sans-serif; font-size: 1.02rem; color: var(--bark-soft); max-width: 40em; margin: 26px auto 0; }

  /* RESEARCH CARDS */
  .rcards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 54px; }
  @media (max-width: 820px) { .rcards { grid-template-columns: 1fr; } }
  .rcard { position: relative; border-radius: var(--radius); padding: 36px 30px 32px; overflow: hidden; transition: transform .4s cubic-bezier(.2,.7,.2,1), box-shadow .4s ease; }
  .rcard:hover { transform: translateY(-6px); box-shadow: 0 28px 54px -30px rgba(63,55,46,.55); }
  .rcard .num { font-family: 'Cormorant Garamond', serif; font-size: 2.7rem; line-height: 1; display: block; margin-bottom: 16px; color: var(--taupe-d); }
  .rcard h3 { font-size: 1.55rem; margin-bottom: 8px; }
  .rcard p { font-size: 1.02rem; color: var(--bark-soft); margin: 0; }
  .rcard.v1 { background: var(--cream); border: 1px solid var(--tan); }
  .rcard.v2 { background: var(--taupe-pale); }
  .rcard.v3 { background: var(--taupe-d); }
  .rcard.v3 .num { color: #cdbfae; } .rcard.v3 h3 { color: #fff; } .rcard.v3 p { color: #e8e1d6; }
  .rcard .wm { position: absolute; right: -18px; bottom: -26px; font-family: 'Cormorant Garamond', serif; font-size: 8rem; line-height: 1; opacity: .06; pointer-events: none; }
  .rcard.v3 .wm { opacity: .14; color: #fff; }

  /* INSTRUMENT CARDS */
  .insts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 50px; }
  @media (max-width: 900px) { .insts { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .insts { grid-template-columns: 1fr; } }
  .icard { background: var(--cream); border: 1px solid var(--tan); border-radius: var(--radius); padding: 28px 22px 24px; text-align: center; transition: transform .4s cubic-bezier(.2,.7,.2,1), box-shadow .4s ease; }
  .icard:hover { transform: translateY(-6px); box-shadow: 0 28px 54px -30px rgba(63,55,46,.55); }
  .icard .art { height: 190px; border-radius: 12px; overflow: hidden; margin-bottom: 16px; }
  .icard .art img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .icard:hover .art img { transform: scale(1.06); }
  .icard h3 { font-size: 1.3rem; margin-bottom: 6px; }
  .icard p { font-size: .92rem; color: var(--bark-soft); margin: 0; }

  /* FULL-BLEED BREAKS */
  .imgbreak { position: relative; height: clamp(320px, 58vh, 600px); background-position: center; background-size: cover; background-repeat: no-repeat; background-attachment: fixed; display: flex; align-items: center; justify-content: center; text-align: center; }
  .imgbreak::after { content: ""; position: absolute; inset: 0; background: rgba(28,25,22,.22); }
  .imgbreak.soft::after { background: rgba(28,25,22,.05); }
  .imgbreak .line { position: relative; z-index: 2; color: #fff; font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: clamp(1.6rem, 3.4vw, 2.8rem); max-width: 13em; padding: 0 24px; text-shadow: 0 2px 26px rgba(0,0,0,.4); }
  @media (max-width: 820px) { .imgbreak { background-attachment: scroll; height: clamp(260px, 42vh, 420px); } }

  /* SESSIONS */
  .sand { background: var(--sand); }
  .twocol { display: grid; grid-template-columns: 1fr 1fr; gap: 34px; margin-top: 48px; }
  @media (max-width: 680px) { .twocol { grid-template-columns: 1fr; } }
  .twocol .c { background: var(--cream); border: 1px solid var(--tan); border-radius: var(--radius); padding: 28px; }
  .twocol .c h3 { font-size: 1.4rem; margin-bottom: 8px; }
  .twocol .c p { font-size: .96rem; color: var(--bark-soft); margin: 0; }

  /* PRICING */
  .price { border-top: 1px solid var(--tan); margin-top: 40px; }
  .price .row { display: grid; grid-template-columns: 1fr auto; gap: 20px; padding: 26px 0; border-bottom: 1px solid var(--tan); align-items: baseline; }
  .price .row .t h3 { font-size: 1.7rem; }
  .price .row .t span { font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; color: var(--taupe-d); font-weight: 700; }
  .price .row .t p { font-size: .96rem; color: var(--bark-soft); margin: 6px 0 0; max-width: 34em; }
  .price .row .amt { font-family: 'Cormorant Garamond', serif; font-size: 2.4rem; color: var(--ink); white-space: nowrap; }
  .promo-line { display: inline-block; background: var(--taupe-d); color: var(--cream); padding: 7px 16px; border-radius: 30px; font-size: .74rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 20px; }

  /* GIVING */
  .gg { display: grid; grid-template-columns: 1.1fr .9fr; gap: 48px; align-items: center; }
  @media (max-width: 760px) { .gg { grid-template-columns: 1fr; gap: 30px; } }
  .gg-img { border-radius: 20px; overflow: hidden; box-shadow: 0 24px 50px -28px rgba(63,55,46,.45); aspect-ratio: 3/2; }
  .gg-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .giving ul { list-style: none; margin: 22px 0 0; max-width: 640px; }
  .giving li { padding-left: 26px; position: relative; margin-bottom: 12px; color: var(--bark-soft); }
  .giving li::before { content: "○"; position: absolute; left: 0; color: var(--taupe); }

  /* BLOG */
  .blog-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 26px; margin-top: 50px; }
  @media (max-width: 760px) { .blog-grid { grid-template-columns: 1fr; } }
  .post { display: flex; flex-direction: column; background: var(--cream); border: 1px solid var(--tan); border-radius: var(--radius); overflow: hidden; transition: .2s; text-decoration: none; color: inherit; }
  .post:hover { transform: translateY(-3px); box-shadow: 0 20px 44px -28px rgba(63,55,46,.5); border-color: var(--taupe); }
  .post-top { padding: 22px 26px 0; }
  .post-tag { font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; color: var(--taupe-d); }
  .post h3 { font-size: 1.4rem; margin: 8px 0 10px; }
  .post p { font-size: .95rem; color: var(--bark-soft); padding: 0 26px; margin: 0; }
  .post-foot { margin-top: auto; padding: 18px 26px 22px; }
  .post-foot span { display: inline-block; background: var(--ink); color: var(--cream); padding: 9px 18px; border-radius: 26px; font-weight: 700; font-size: .82rem; transition: .2s; }
  .post:hover .post-foot span { background: var(--taupe-d); }
  .seeall { text-align: center; margin-top: 40px; }
  .seeall a { display: inline-block; border: 1.4px solid var(--ink); color: var(--ink); text-decoration: none; font-size: .74rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; padding: 13px 26px; border-radius: 30px; }
  .seeall a:hover { background: var(--ink); color: var(--cream); }

  /* ABOUT */
  .about-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 48px; align-items: center; }
  @media (max-width: 760px) { .about-grid { grid-template-columns: 1fr; } }
  .about-photo { aspect-ratio: 3/4; border-radius: 20px; background: url('/img-about.jpg') center/cover; box-shadow: 0 24px 50px -28px rgba(63,55,46,.45); }
  .cred { display: inline-flex; align-items: center; gap: 8px; background: var(--sand); border: 1px solid var(--tan); padding: 8px 16px; border-radius: 30px; font-size: .84rem; font-weight: 600; margin-top: 18px; }

  /* FAQ */
  details { border-bottom: 1px solid var(--tan); padding: 0; }
  details summary { cursor: pointer; font-family: 'Cormorant Garamond', serif; font-size: 1.35rem; color: var(--ink); padding: 20px 0; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  details summary::-webkit-details-marker { display: none; }
  details summary::after { content: "+"; color: var(--taupe-d); font-size: 1.5rem; }
  details[open] summary::after { content: "–"; }
  details p { padding: 0 0 22px; color: var(--bark-soft); font-size: .98rem; max-width: 60em; }

  /* CONTACT */
  .contact { background: var(--taupe-d); color: #f3efe9; text-align: center; }
  .contact .eyebrow { color: #d8cdbf; }
  .contact h2 { color: #fff; }
  .contact p { max-width: 560px; margin: 0 auto 28px; color: #e8e1d6; }
  .btn-pair { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; align-items: center; }
  .wa-btn { display: inline-flex; align-items: center; gap: 10px; background: #25d366; color: #fff; padding: 15px 28px; border-radius: 34px; font-weight: 700; font-size: 1rem; text-decoration: none; }
  .wa-btn:hover { filter: brightness(1.05); }
  .form-btn { display: inline-flex; align-items: center; gap: 10px; background: transparent; color: #fff; padding: 14px 26px; border-radius: 34px; font-weight: 700; font-size: 1rem; border: 1.5px solid rgba(255,255,255,.6); text-decoration: none; }
  .form-btn:hover { background: rgba(255,255,255,.12); border-color: #fff; }
  .contact small { display: block; margin-top: 18px; opacity: .75; font-size: .82rem; }
</style>

<div class="promo">&#10022;&nbsp;&nbsp;20% off rates for July 2026</div>

<header class="nav">
  <div class="nav-inner">
    <a class="brand" href="/"><span class="dot"></span>Calm Through Sounds</a>
    <button class="hamburger" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="navMenu">
      <span></span><span></span><span></span>
    </button>
    <div class="nav-menu" id="navMenu">
      <nav>
        <ul>
          <li><a href="#science">The Science</a></li>
          <li><a href="#sessions">Sessions</a></li>
          <li><a href="#pricing">Pricing</a></li>
          <li><a href="#testimonials">Testimonials</a></li>
          <li><a href="#giving">Giving</a></li>
          <li><a href="/blog/">Journal</a></li>
          <li><a href="#about">About</a></li>
        </ul>
      </nav>
      <a class="nav-cta" href="/book/">Book a session</a>
    </div>
  </div>
</header>

<!-- HERO -->
<section class="hero" id="top" style="padding:0">
  <svg class="waves" viewBox="0 0 1600 230" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M0 115 Q200 60 400 115 T800 115 T1200 115 T1600 115"/>
    <path d="M0 135 Q200 80 400 135 T800 135 T1200 135 T1600 135" opacity=".5"/>
    <path d="M0 155 Q200 100 400 155 T800 155 T1200 155 T1600 155" opacity=".3"/>
  </svg>
  <h1 class="wordmark">C<span class="thin">A</span>LM</h1>
  <div class="hero-cap">
    <span class="k serif">Gong &middot; Crystal bowl</span>
    <span class="k serif">Ocean drum &middot; Chimes</span>
    <span class="v">Research-Informed Sound Therapy</span>
  </div>
  <div class="hero-tag">
    <em class="serif">Quiet the noise. Find your calm.</em>
    <a href="/book/">Book a session &rarr;</a>
  </div>
</section>

<!-- STATEMENT -->
<section class="statement">
  <div class="wrap">
    <p class="serif">Rest is not a luxury. It is where the body quietly repairs.</p>
    <p class="sm">Research-Informed Sound Therapy in a home studio for stressed minds, tired bodies, and the people who care for others.</p>
  </div>
</section>

<!-- IMAGE BREAK -->
<section class="imgbreak soft" style="background-image:url('/img-instruments.jpg')" aria-hidden="true"></section>

<!-- SCIENCE -->
<section id="science">
  <div class="wrap">
    <span class="eyebrow">Grounded in research</span>
    <h2>What sound does for a stressed body</h2>
    <p class="lead">Not mysticism, measurable calm.</p>
    <div class="rcards">
      <div class="rcard v1"><span class="num">01</span><h3>Tension eases</h3><p>Perceived stress may soften, leaving the mind and body feeling more settled.</p><span class="wm">01</span></div>
      <div class="rcard v2"><span class="num">02</span><h3>The body begins to settle</h3><p>A gentle invitation away from high alert and toward rest.</p><span class="wm">02</span></div>
      <div class="rcard v3"><span class="num">03</span><h3>Rest in difficult seasons</h3><p>A restorative pause during illness, recovery, caregiving or emotional strain.</p><span class="wm">03</span></div>
    </div>
    <div class="seeall" style="text-align:left;margin-top:46px"><a href="/blog/how-sound-calms-the-nervous-system/">Explore the benefits &amp; the science &rarr;</a></div>
  </div>
</section>

<!-- SESSIONS -->
<section class="sand" id="sessions">
  <div class="wrap">
    <span class="eyebrow">Your hour of calm</span>
    <h2>Sessions &amp; instruments</h2>
    <p class="lead">Lie down. Breathe. Let the sound do the rest.</p>
    <div class="insts">
      <div class="icard">
        <div class="art"><img src="/img-bowl.jpg" alt="Crystal singing bowl" width="300" height="190" loading="lazy" /></div>
        <h3 class="serif">Crystal bowl</h3><p>Clear, sustained tones.</p>
      </div>
      <div class="icard">
        <div class="art"><img src="/img-gong.jpg" alt="Gong" width="300" height="190" loading="lazy" /></div>
        <h3 class="serif">Gong</h3><p>Deep, enveloping waves.</p>
      </div>
      <div class="icard">
        <div class="art"><img src="/img-ocean.jpg" alt="Ocean drum" width="300" height="190" loading="lazy" /></div>
        <h3 class="serif">Ocean drum</h3><p>A soft, sea-like hush.</p>
      </div>
      <div class="icard">
        <div class="art"><img src="/img-chimes.jpg" alt="Chimes" width="300" height="190" loading="lazy" /></div>
        <h3 class="serif">Chimes</h3><p>Light, shimmering close.</p>
      </div>
    </div>
    <div class="twocol">
      <div class="c"><h3 class="serif">1-on-1 private</h3><p>Personalised to how you feel that day.</p></div>
      <div class="c"><h3 class="serif">Small group (2–4)</h3><p>Share the calm with family or friends.</p></div>
    </div>
  </div>
</section>

<!-- IMAGE BREAK -->
<section class="imgbreak" style="background-image:url('/img-hands.jpg')"><p class="line">An hour that's entirely about your rest.</p></section>

<!-- PRICING -->
<section id="pricing">
  <div class="wrap">
    <span class="eyebrow">Pricing</span>
    <h2>Your session, your pace</h2>
    <div class="price">
      <div class="row">
        <div class="t"><span>30 minutes · 1 person</span><h3 class="serif">Taster Session</h3><p>A gentle first taste.</p></div>
        <div class="amt">$50</div>
      </div>
      <div class="row">
        <div class="t"><span>60 minutes · 1 person</span><h3 class="serif">Signature Session</h3><p>The full sound journey, start to finish.</p></div>
        <div class="amt">$120</div>
      </div>
    </div>
  </div>
</section>

<!-- TESTIMONIALS -->
<section class="testi" id="testimonials">
  <div class="wrap">
    <span class="eyebrow">In their words</span>
    <h2>What guests say</h2>
    <div class="quotes">
      <figure class="tcard">
        <div class="stars" aria-hidden="true">★★★★★</div>
        <blockquote><p>"I loved the gong bath. I felt so relaxed after the sound session and I can't wait to book my next session."</p></blockquote>
        <figcaption>Mel</figcaption>
      </figure>
      <!-- More testimonials get added here later as <figure class="tcard"> blocks. -->
    </div>
  </div>
</section>

<!-- NEWSLETTER -->
<NewsletterSignup />

<!-- GIVING -->
<section class="sand giving" id="giving">
  <div class="wrap gg">
    <div>
      <span class="eyebrow">The heart behind Calm Through Sounds</span>
      <h2>Sound, freely given</h2>
      <p>The people who need rest most often get it least. Calm Through Sounds offers complimentary sessions to hospitals and senior care centres, for their patients and caregivers.</p>
      <ul>
        <li>Complimentary sessions delivered at partnering hospitals and senior care centres</li>
        <li>For patients and caregivers who need rest most</li>
        <li>A moment of stillness in the middle of a hard season</li>
      </ul>
      <p style="margin-top:20px">If you work with a hospital or care facility and would like to bring sound therapy to your patients or caregivers, please <a href="#contact">reach out</a>. I would be honoured to help.</p>
    </div>
    <div class="gg-img"><img src="/img-giving.jpg" alt="Two hands held in comfort" width="500" height="333" loading="lazy" /></div>
  </div>
</section>

<!-- IMAGE BREAK -->
<section class="imgbreak" style="background-image:url('/img-studio.jpg')"><p class="line">Minutes from your doorstep in Bukit Panjang.</p></section>

<!-- BLOG -->
<section id="blog">
  <div class="wrap">
    <span class="eyebrow">Reading room</span>
    <h2>The science of sound, explained simply</h2>
    <p class="lead">Honest, research-informed articles on how sound affects the body and mind.</p>
    <div class="blog-grid">
      {posts.map(post => (
        <a class="post" href={`/blog/${post.id}/`}>
          <div class="post-top">
            <span class="post-tag">{post.data.tag}</span>
            <h3 class="serif">{post.data.title}</h3>
          </div>
          <p>{post.data.description}</p>
          <span class="post-foot"><span>Read article &rarr;</span></span>
        </a>
      ))}
    </div>
    <div class="seeall"><a href="/blog/">See all articles &rarr;</a></div>
  </div>
</section>

<!-- ABOUT -->
<section class="sand" id="about">
  <div class="wrap about-grid">
    <div class="about-photo"></div>
    <div>
      <span class="eyebrow">Hello, I'm Cara</span>
      <h2>A calm pair of hands in your neighbourhood</h2>
      <p>I'm a certified sound therapist in Bukit Panjang. My approach is simple: a warm, judgement-free space, real attention to how you're feeling, and an hour that's entirely about your rest, grounded in evidence, never woo.</p>
      <p>Managing a health condition, caring for someone who is, or simply worn thin? You're welcome here.</p>
      <span class="cred">✦ Certified Sound Therapist · Shantika Sound Therapy Training, Singapore</span>
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="faq">
  <div class="wrap" style="max-width:820px">
    <span class="eyebrow">Good to know</span>
    <h2>Common questions</h2>
    <div style="margin-top:34px">
      <details open>
        <summary>What actually happens in a session?</summary>
        <p>You arrive, we have a short chat about how you're feeling, then you lie down fully clothed on a mat with a blanket. For the next 30–60 minutes you simply rest while I play the instruments around you. Many people drift into a deeply relaxed, half-asleep state.</p>
      </details>
      <details>
        <summary>Is this religious or spiritual?</summary>
        <p>No. Calm Through Sounds is a wellness practice focused on rest and stress relief, grounded in what research shows about the body and sound. You're welcome here whatever your beliefs.</p>
      </details>
      <details>
        <summary>Can it replace my medical treatment?</summary>
        <p>Absolutely not, and I'll never suggest it can. Sound therapy is complementary. It works alongside your medical care to help you relax and cope, never in place of your doctor's advice.</p>
      </details>
      <details>
        <summary>Is it safe for everyone?</summary>
        <p>It's gentle and suitable for most people. As a precaution, please let me know in advance if you are pregnant, have epilepsy or a seizure history, a pacemaker or other implant, severe mental-health conditions, or recent surgery, so we can adapt or check with your doctor first.</p>
      </details>
      <details>
        <summary>Where is the studio?</summary>
        <p>It's a home studio in Bukit Panjang. I'll share the exact address when you book.</p>
      </details>
    </div>
