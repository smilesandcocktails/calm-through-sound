<script>
  (function () {
    const wm = document.querySelector('.wordmark') as HTMLElement | null;
    const wv = document.querySelector('.waves') as HTMLElement | null;
    if (!wm) return;
    let ticking = false;
    function update() {
      ticking = false;
      if (window.innerWidth <= 820) { wm!.style.transform = ''; if (wv) wv.style.transform = ''; return; }
      const y = window.scrollY || 0;
      wm!.style.transform = `translate(-50%, calc(-50% + ${y * 0.10}px))`;
      if (wv) wv.style.transform = `translate(-50%, calc(-50% - ${y * 0.05}px))`;
    }
    window.addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(update); ticking = true; } }, { passive: true });
  })();
</script>
